# --- App ---
APP_NAME="MF Ventures Equipment Maintenance API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- Database ---
# Async URL used by the app
DATABASE_URL=postgresql+asyncpg://mf_user:mf_password@db:5432/mf_maintenance
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://mf_user:mf_password@db:5432/mf_maintenance

POSTGRES_USER=mf_user
POSTGRES_PASSWORD=mf_password
POSTGRES_DB=mf_maintenance

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- File storage ---
STORAGE_DIR=/app/storage/attachments
MAX_UPLOAD_MB=15

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- First admin user (created on startup if no admin exists) ---
FIRST_ADMIN_EMAIL=admin@mfventures.com
FIRST_ADMIN_PASSWORD=change-this-password
FIRST_ADMIN_FULL_NAME="System Administrator"
